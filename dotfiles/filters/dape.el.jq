# Generate .dape.el debug configurations from Justfile json dump
# Uses debugger configurations from slurpfile
[
  .recipes
  | to_entries[]
  | select(
      .value.attributes[]?.metadata?
      | select(. != null)
      | flatten
      | any(. == "launch")
    )
  | . as $recipe
  | [$recipe.value.attributes[]?.metadata? | select(. != null) | flatten] | flatten | unique as $all_metadata
  | ($all_metadata[] | select((. == "debug") or (. | startswith("debug:")))) as $debugtuple
  | (if ($debugtuple | startswith("debug:")) then ($debugtuple | ltrimstr("debug:")) else "default" end) as $debugtype
  | (if ($config[0]["debug"][$debugtype] | type) == "string" then $config[0]["debug"][$debugtype] else $debugtype end) as $debugtype
  | (if ($config[0]["debug"][$debugtype] | type) == "string" then $config[0]["debug"][$debugtype] else $debugtype end) as $debugtype
  | (if ($config[0]["debug"][$debugtype] | type) != "object" then error("Invalid debug configuration '" + $debugtype + "', should be a dict") end)
  | $config[0]["debug"][$debugtype] as $dbg
  | ($recipe.value.name + (if ($debugtuple == "debug") then "" else "/" + $debugtype end)) as $symbol
  | "  (add-to-list 'dape-configs\n    '("
    + $symbol + "\n"
    + "      modes (" + ($dbg.modes | join(" ")) + ")\n"
    + "      command \"" + $dbg.command + "\"\n"
    + "      command-args (" + ($dbg.command_args | map("\"" + . + "\"") | join(" ")) + ")\n"
    + ($dbg.request_params | to_entries | map("      :" + .key + " \"" + (.value | tostring) + "\"") | join("\n")) + "\n"
    + "      :program \"" + $just + "\"\n"
    + "      :args [\"" + $recipe.key + "\"]))"
] as $entries
| ";;; Generated by justfile — do not edit manually\n"
  + if ($entries | length) == 0 then ""
    else "(with-eval-after-load 'dape\n" + ($entries | join("\n")) + ")\n"
    end
